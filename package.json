{
  "name": "vberry",
  "version": "6.2.0",
  "description": "Chrome-native vertical tab tree & tab group manager with Sidebery import",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "package": "npm run build && mkdir -p dist && (cd addon && zip -rq ../dist/vberry-v6.2.0.zip .)",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clear": "rm -rf addon dist"
  },
  "license": "MIT",
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "sideEffects": false
}
